{
  "name": "@tanaw/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Tanaw background worker: tools, parsers, AI jobs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "postinstall": "prisma generate --schema ../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanaw/shared": "*",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.1",
    "prisma": "^6.19.3",
    "zod": "^4.1.12"
  }
}
