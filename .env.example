# Copy to .env (root). Used by docker compose and by every app in dev.
# Never commit .env. Never paste real keys into docs, chat or screenshots.

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=Tanaw
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=tanaw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tanaw
DATABASE_URL=postgresql://tanaw:change-me@localhost:5432/tanaw
# API tests (Supertest) run against this database. It is wiped on every test run, so never point it at real data.
TEST_DATABASE_URL=postgresql://tanaw:change-me@localhost:5432/tanaw_test

# ── Queue (Redis / BullMQ) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-another-long-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# bcrypt cost for password hashes (10-14; tests use 4)
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
# First admin, created by `npm run seed --workspace @tanaw/api` (change the password after first login)
SEED_ADMIN_EMAIL=admin@tanaw.local
SEED_ADMIN_PASSWORD=change-me-Strong1!
SEED_ADMIN_NAME=Tanaw Admin

# ── Scope safety ─────────────────────────────────────────────────────────────
# Hard allowlist: nothing outside these hosts can be registered, scanned or imported.
ASSESSMENT_ALLOWED_HOSTS=bayawjobs.riomar.dev,bayawjobs-api.riomar.dev,localhost,127.0.0.1

# ── Tools (worker) ───────────────────────────────────────────────────────────
NMAP_BIN=nmap
NMAP_DEFAULT_PORTS=80,443
TOOL_TIMEOUT_MS=900000
# ZAP runs as a daemon container; the worker talks to its API.
ZAP_API_URL=http://localhost:8090
ZAP_API_KEY=change-me-zap-key
# Active (attacking) ZAP scans stay off unless the instructor approves them.
ZAP_ACTIVE_SCAN_ENABLED=false

# ── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
AI_DAILY_LIMIT=20
AI_MAX_INPUT_CHARS=12000

# ── Storage (evidence + raw reports) ─────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_IMPORT_SIZE_MB=5

# ── Web (Next.js reads NEXT_PUBLIC_* at build time) ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
