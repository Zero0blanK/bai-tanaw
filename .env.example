# Copy to .env (root). Used by docker compose and by every app in dev.
# Never commit .env. Never paste real keys into docs, chat or screenshots.

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=Bai-Tanaw
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Port the API listens on (dev). In Docker the API always listens on 4000 inside the container.
PORT=4000
# Docker demo only: host ports for the web and API (bound to 127.0.0.1). If you change WEB_PORT, add that
# origin to CORS_ORIGIN; if you change API_PORT, update NEXT_PUBLIC_API_URL and rebuild the web image.
WEB_PORT=3000
API_PORT=4000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=tanaw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tanaw
# 127.0.0.1, not localhost: Docker publishes the ports on IPv4 loopback only, and localhost may resolve to ::1 first.
DATABASE_URL=postgresql://tanaw:change-me@127.0.0.1:5432/tanaw
# API tests (Supertest) run against this database. It is wiped on every test run, so never point it at real data.
TEST_DATABASE_URL=postgresql://tanaw:change-me@127.0.0.1:5432/tanaw_test

# ── Queue (Redis / BullMQ) ───────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
# Jobs the worker runs at once (ZAP runs are always one at a time)
WORKER_CONCURRENCY=2

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-another-long-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# bcrypt cost for password hashes (10-14; tests use 4)
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
# First admin, created by `npm run seed --workspace @tanaw/api` (change the password after first login)
SEED_ADMIN_EMAIL=admin@tanaw.local
SEED_ADMIN_PASSWORD=change-me-Strong1!
SEED_ADMIN_NAME=Bai-Tanaw Admin

# ── Scope safety ─────────────────────────────────────────────────────────────
# Hard allowlist: nothing outside these hosts can be registered, scanned or imported.
# host.docker.internal is how the Docker worker and ZAP reach a target running on this PC (e.g. Bayaw Jobs on
# wrangler dev at :8787); localhost/127.0.0.1 are for the dev worker running on the host.
ASSESSMENT_ALLOWED_HOSTS=bayawjobs.riomar.dev,bayawjobs-api.riomar.dev,localhost,127.0.0.1,host.docker.internal

# ── Tools (worker) ───────────────────────────────────────────────────────────
NMAP_BIN=nmap
NMAP_DEFAULT_PORTS=80,443
TOOL_TIMEOUT_MS=900000
# ZAP runs as a daemon container; the worker talks to its API.
ZAP_API_URL=http://127.0.0.1:8090
ZAP_API_KEY=change-me-zap-key
# Active (attacking) ZAP scans stay off unless the instructor approves them.
ZAP_ACTIVE_SCAN_ENABLED=false
# Upper bound for one ZAP spider run, in minutes
ZAP_SPIDER_MAX_MINUTES=5

# ── AI ───────────────────────────────────────────────────────────────────────
# Provider (OpenRouter, OpenAI or Ollama), model and API key are set by an admin in the app (Settings page),
# not here. The API key is encrypted (AES-256-GCM, key derived with scrypt from SETTINGS_ENCRYPTION_KEY) before
# it is stored. `npm run env:init` generates SETTINGS_ENCRYPTION_KEY; if it changes, re-enter the API key in Settings.
SETTINGS_ENCRYPTION_KEY=change-me-settings-encryption-key-at-least-32-chars
# Only used when Settings picks Ollama
OLLAMA_URL=http://localhost:11434
AI_DAILY_LIMIT=20
AI_MAX_INPUT_CHARS=12000

# ── Storage (evidence + raw reports) ─────────────────────────────────────────
# Only "local" exists today (files under STORAGE_LOCAL_DIR, relative to the repo root)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_IMPORT_SIZE_MB=5

# ── Web (Next.js reads NEXT_PUBLIC_* at build time) ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
