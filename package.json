{
  "name": "tanaw",
  "version": "0.1.0",
  "private": true,
  "description": "Tanaw: AI-assisted security assessment and vulnerability analysis platform (CS24 final project)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d postgres redis zap",
    "infra:down": "docker compose down",
    "env:init": "node scripts/init-env.mjs",
    "demo:up": "docker compose --profile app up -d --build",
    "demo:seed": "docker compose run --rm api node dist/scripts/seed.js",
    "demo:logs": "docker compose --profile app logs -f api worker",
    "demo:down": "docker compose --profile app down",
    "dev:api": "npm run dev --workspace @tanaw/api",
    "dev:worker": "npm run dev --workspace @tanaw/worker",
    "dev:web": "npm run dev --workspace @tanaw/web",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && eslint scripts",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @tanaw/shared && npm run build -w @tanaw/api -w @tanaw/worker -w @tanaw/web",
    "db:migrate": "npm run db:migrate -w @tanaw/api",
    "db:deploy": "npm run db:deploy -w @tanaw/api",
    "seed": "npm run seed -w @tanaw/api",
    "acceptance": "node scripts/acceptance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
